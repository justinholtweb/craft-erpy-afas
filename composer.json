{
    "name": "justinholtweb/craft-erpy-afas",
    "description": "AFAS Profit connector for Erpy.",
    "version": "5.0.0",
    "type": "craft-plugin",
    "keywords": [
        "craftcms",
        "craft-plugin",
        "craft-commerce",
        "erpy",
        "erp",
        "afas",
        "profit",
        "integration"
    ],
    "license": "proprietary",
    "homepage": "https://justinholt.com/plugins/craft-erpy",
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com",
        "docs": "https://justinholt.com/plugins/craft-erpy/docs/afas",
        "source": "https://github.com/justinholtweb/craft-erpy-afas",
        "issues": "https://github.com/justinholtweb/craft-erpy-afas/issues"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.3.0",
        "justinholtweb/craft-erpy": "^5.0.0"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\erpyafas\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "extra": {
        "name": "Erpy for AFAS",
        "handle": "erpy-afas",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://justinholt.com/plugins/craft-erpy/docs/afas",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-erpy-afas/main/CHANGELOG.md",
        "class": "justinholtweb\\erpyafas\\Plugin"
    }
}
